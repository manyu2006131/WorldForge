{
  "name": "worldforge",
  "version": "0.1.0",
  "private": true,
  "description": "世界工坊离线游戏规划工具",
  "author": "WorldForge",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "dist:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "konva": "^10.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.2.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.worldforge.desktop",
    "productName": "世界工坊 WorldForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  }
}
